# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Test sources and fixtures stay tracked: CI uses them before deployment.
# Generated test output and local browser downloads do not belong in Git.
/coverage/
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/
/.cache/

# Local datapacks and scratch files (not application assets or test fixtures)
/*.zip
/*.jar
/tmp/
/temp/
*.log

# next.js
/.next/
/.next-dev/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.github/agents/
.github/hooks/
.github/skills/
.agents
.codex

# Local approved UI proposal
/UI_IMPROVEMENT_PROPOSAL.md
